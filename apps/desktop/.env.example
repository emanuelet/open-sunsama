# Desktop build configuration
#
# Copy this file to the repository-root .env or export these values before
# running `bun run build:desktop`. They are embedded in the desktop bundle.

# Public HTTPS URL for the API. Required for a self-hosted desktop build.
# VITE_API_URL=https://api.tasks.example.com

# Optional when the WebSocket endpoint uses the same host as VITE_API_URL.
# VITE_WS_URL=wss://api.tasks.example.com

# Required only when producing signed updater artifacts. Keep this private key
# out of source control. Generate one with
# `bun run --filter=@open-sunsama/desktop tauri signer generate -w`.
# TAURI_SIGNING_PRIVATE_KEY=/absolute/path/to/opensunsama.key
