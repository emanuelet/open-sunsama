{
  "name": "@open-sunsama/expo-mobile",
  "version": "1.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf node_modules .turbo .expo"
  },
  "dependencies": {
    "@open-sunsama/api-client": "workspace:*",
    "@open-sunsama/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/lucide": "^13.1.4",
    "@tanstack/react-query": "catalog:",
    "date-fns": "catalog:",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  },
  "bun": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    },
    "install": {
      "local": [
        "react",
        "react-native",
        "scheduler"
      ]
    }
  }
}
